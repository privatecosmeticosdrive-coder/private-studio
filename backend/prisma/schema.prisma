// ============================================================
// Private Studio (v9) — Prisma schema
// Modelo de dados conforme Doc 2 (sistema novo), secao 3 + secao 11.
//
// Convencoes:
//  - Modelos em PascalCase; tabelas/colunas em snake_case via @map/@@map.
//  - PKs de entidades de negocio (users, clientes, orcamentos) = UUID.
//  - PKs herdadas do KB (materias_primas, formulas) = autoincrement,
//    preservando os codigos/ids originais em colunas dedicadas.
//  - Campos extra (batelada, total_ingredientes, snapshots de preco) foram
//    ADICIONADOS alem do Doc 2 para NAO perder dados do kb.json original.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------- ENUMS -----------------------

enum Role {
  admin
  comercial
  pd
  compras
  producao
}

// formulas.origem e formulas.status sao String (Doc 2b §A7 — VARCHAR).
//   origem:  'banco_original' | 'ia_gerada' | 'pd_manual' | ...
//   status:  'rascunho' | 'validada' | 'arquivada'

enum OrcamentoNivel {
  basic
  inter
  premium
}

// orcamentos.status e String (Doc 2c — estados revisados):
//   rascunho | aprovado_interno | enviado | aprovado_cliente
//   | em_amostragem | em_producao | concluido | rejeitado | arquivado
// orcamentos.amostra_status (Doc 2c §2):
//   nao_solicitada | solicitada | em_producao | pronta | enviada
//   | aprovada_cliente | rejeitada

// cotacoes_pendentes.status e String:
//   aguardando | validada_pd | validada_compras | rejeitada | integrada

// ----------------------- USERS -----------------------

model User {
  id            String   @id @default(uuid()) @db.Uuid
  email         String   @unique
  nome          String
  password_hash String
  role          Role
  ativo         Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  clientes_criados     Cliente[]          @relation("ClienteCreatedBy")
  formulas_criadas     Formula[]          @relation("FormulaCreatedBy")
  formulas_validadas   Formula[]          @relation("FormulaValidadaPor")
  orcamentos_criados   Orcamento[]        @relation("OrcamentoCreatedBy")
  amostras_solicitadas Orcamento[]        @relation("AmostraSolicitadaPor")
  amostras_responsavel Orcamento[]        @relation("AmostraResponsavel")
  cotacoes_criadas     CotacaoPendente[]  @relation("CotacaoCreatedBy")
  cotacoes_validadas   CotacaoPendente[]  @relation("CotacaoValidadaPor")
  historico_precos_reg MpHistoricoPreco[] @relation("HistoricoRegistradoPor")
  amostra_eventos_reg  AmostraEvento[]    @relation("AmostraEventoPor")
  audit_logs           AuditLog[]

  @@map("users")
}

// ----------------------- CLIENTES -----------------------

model Cliente {
  id          String   @id @default(uuid()) @db.Uuid
  nome        String
  cnpj        String?
  email       String?
  telefone    String?
  observacoes String?
  created_at  DateTime @default(now())
  created_by  String?  @db.Uuid

  criado_por User?       @relation("ClienteCreatedBy", fields: [created_by], references: [id])
  formulas   Formula[]
  orcamentos Orcamento[]

  @@map("clientes")
}

// ----------------------- MATERIAS-PRIMAS -----------------------

model MateriaPrima {
  id                     Int       @id @default(autoincrement())
  codigo                 Int       @unique
  nome                   String
  preco_kg_brl           Decimal?  @db.Decimal(10, 2)
  preco_anterior         Decimal?  @db.Decimal(10, 2)
  aumento_pct            Decimal?  @db.Decimal(6, 2)
  fornecedor             String?
  embalagem_minima       String?
  data_cotacao           DateTime? @db.Date
  validade_cotacao       String?
  n_formulas_uso         Int       @default(0)
  validado_pd            Boolean   @default(false)
  validado_compras       Boolean   @default(false)
  ativo                  Boolean   @default(true)
  flag_aumento_relevante Boolean   @default(false)
  observacoes            String?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  fornecedores_alt   MpFornecedorAlt[]
  composicoes        FormulaComposicao[]
  cotacoes_pendentes CotacaoPendente[]
  historico_precos   MpHistoricoPreco[]

  @@index([nome])
  @@map("materias_primas")
}

// ----------------------- FORNECEDORES ALTERNATIVOS (M:N) -----------------------

model MpFornecedorAlt {
  id            Int       @id @default(autoincrement())
  mp_id         Int
  fornecedor    String
  preco_kg_brl  Decimal?  @db.Decimal(10, 2)
  prazo_entrega String?
  observacoes   String?
  data_cotacao  DateTime? @db.Date

  mp MateriaPrima @relation(fields: [mp_id], references: [id], onDelete: Cascade)

  @@index([mp_id])
  @@map("mp_fornecedores_alt")
}

// ----------------------- FORMULAS -----------------------

model Formula {
  id           Int       @id @default(autoincrement())
  nome_produto String
  cliente_id   String?   @db.Uuid
  data_criacao DateTime? @db.Date
  responsavel  String?
  custo_mp_kg  Decimal?  @db.Decimal(10, 2)
  categoria    String?
  observacoes  String?

  // VERSIONAMENTO / LABORATORIO VIVO (Doc 2b §A7)
  formula_mae_id   Int? // null = e a propria mae (raiz da familia)
  derivada_de_id   Int? // versao imediatamente anterior de onde nasceu
  versao_codigo    String? // '1.0', '1.1', '2.0'... (preenchido pela promocao)
  versao_descricao String?
  origem           String  @default("banco_original") // string livre (Doc 2b)
  status           String  @default("rascunho") // rascunho | validada | arquivada

  // AUDITORIA DE VALIDACAO
  validada_em      DateTime?
  validada_por     String?   @db.Uuid
  validacao_obs    String?
  diff_vs_anterior Json? // {alteracoes:[...], custo_anterior_kg, custo_novo_kg, delta_pct}

  // Campos preservados do kb.json (alem do Doc 2):
  batelada           String?
  total_ingredientes Int?
  cliente_original   String? // nome do cliente no KB (antes de virar cliente_id)

  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt

  cliente     Cliente?            @relation(fields: [cliente_id], references: [id])
  criado_por  User?               @relation("FormulaCreatedBy", fields: [created_by], references: [id])
  validador   User?               @relation("FormulaValidadaPor", fields: [validada_por], references: [id])
  formula_mae Formula?            @relation("FormulaMae", fields: [formula_mae_id], references: [id])
  versoes     Formula[]           @relation("FormulaMae")
  derivada_de Formula?            @relation("FormulaDerivada", fields: [derivada_de_id], references: [id])
  derivacoes  Formula[]           @relation("FormulaDerivada")
  composicao  FormulaComposicao[]
  orcamentos  Orcamento[]

  @@index([categoria])
  @@index([origem])
  @@index([formula_mae_id])
  @@index([status])
  @@map("formulas")
}

// ----------------------- COMPOSICAO DAS FORMULAS -----------------------

model FormulaComposicao {
  id                        Int      @id @default(autoincrement())
  formula_id                Int
  fase                      String?
  ordem                     Int?
  mp_id                     Int?
  mp_nome_original          String? // nome no KB; preservado p/ casos sem match
  concentracao_pct          Decimal? @db.Decimal(6, 3)
  funcao                    String?
  fornecedor_pref           String?
  // Snapshots historicos preservados do kb.json (NAO usar como preco atual):
  preco_kg_snapshot         Decimal? @db.Decimal(10, 2)
  custo_na_formula_snapshot Decimal? @db.Decimal(10, 4)

  formula Formula       @relation(fields: [formula_id], references: [id], onDelete: Cascade)
  mp      MateriaPrima? @relation(fields: [mp_id], references: [id])

  @@index([formula_id])
  @@index([mp_id])
  @@map("formula_composicao")
}

// ----------------------- ORCAMENTOS -----------------------

model Orcamento {
  id                 String          @id @default(uuid()) @db.Uuid
  numero             Int             @unique @default(autoincrement())
  cliente_id         String?         @db.Uuid
  produto            String
  categoria          String?
  nivel              OrcamentoNivel?
  volume_un          Decimal?        @db.Decimal(8, 2)
  quantidade         Int?
  margem_pct         Decimal?        @db.Decimal(5, 2)
  formula_id         Int?
  embalagem          String?
  budget_mp          Decimal?        @db.Decimal(10, 2)
  produto_referencia String?
  status             String          @default("rascunho")

  // JSON_CALC travado (Fase 1). Nullable: rascunho ainda nao calculado.
  calculo Json?

  // SNAPSHOT da formula no momento do orcamento (Doc 2b §A8)
  // orcamento antigo continua refletindo o que foi cotado na epoca
  formula_versao_codigo       String?
  formula_status_momento      String?
  formula_composicao_snapshot Json?

  // PIPELINE DE AMOSTRAGEM (Doc 2c §5.1)
  requer_amostra               Boolean   @default(true)
  amostra_status               String    @default("nao_solicitada")
  amostra_solicitada_em        DateTime?
  amostra_solicitada_por       String?   @db.Uuid
  amostra_producao_iniciada_em DateTime?
  amostra_responsavel_id       String?   @db.Uuid
  amostra_pronta_em            DateTime?
  amostra_enviada_em           DateTime?
  amostra_retorno_em           DateTime?
  amostra_qtd                  Int?
  amostra_observacoes_lab      String?
  amostra_feedback_cliente     String?

  // HOOKS p/ integracoes futuras (NULL na v9 — Doc 2c)
  clickup_task_id String?
  crm_deal_id     String?

  // Conteudo das 4 paginas (Fase 2)
  conteudo_pag1 String? // Comercial
  conteudo_pag2 String? // Industrial
  conteudo_pag3 String? // Formula P&D
  conteudo_pag4 String? // Cotacoes

  score_global Int?
  preco_sipi   Decimal? @db.Decimal(10, 2)
  preco_cipi   Decimal? @db.Decimal(10, 2)
  pdf_url      String?

  created_at DateTime @default(now())
  created_by String?  @db.Uuid
  updated_at DateTime @updatedAt

  cliente             Cliente?        @relation(fields: [cliente_id], references: [id])
  formula             Formula?        @relation(fields: [formula_id], references: [id])
  criado_por          User?           @relation("OrcamentoCreatedBy", fields: [created_by], references: [id])
  amostra_solicitante User?           @relation("AmostraSolicitadaPor", fields: [amostra_solicitada_por], references: [id])
  amostra_responsavel User?           @relation("AmostraResponsavel", fields: [amostra_responsavel_id], references: [id])
  amostra_eventos     AmostraEvento[]

  @@index([status])
  @@index([cliente_id])
  @@index([amostra_status])
  @@index([amostra_responsavel_id])
  @@map("orcamentos")
}

// ----------------------- COTACOES PENDENTES -----------------------

model CotacaoPendente {
  id               Int       @id @default(autoincrement())
  mp_id            Int?
  fornecedor       String
  quantidade       Decimal?  @db.Decimal(10, 2)
  unidade          String? // kg, L, un
  valor            Decimal?  @db.Decimal(10, 2)
  prazo_entrega    String?
  validade_cotacao DateTime? @db.Date
  observacoes      String?
  status           String    @default("aguardando")
  created_at       DateTime  @default(now())
  created_by       String?   @db.Uuid
  validada_por     String?   @db.Uuid
  validada_em      DateTime?

  mp         MateriaPrima? @relation(fields: [mp_id], references: [id])
  criado_por User?         @relation("CotacaoCreatedBy", fields: [created_by], references: [id])
  validador  User?         @relation("CotacaoValidadaPor", fields: [validada_por], references: [id])

  @@index([status])
  @@map("cotacoes_pendentes")
}

// ----------------------- AUDITORIA -----------------------

model AuditLog {
  id          Int      @id @default(autoincrement())
  user_id     String?  @db.Uuid
  acao        String
  entidade    String?
  entidade_id String?
  detalhes    Json?
  created_at  DateTime @default(now())

  user User? @relation(fields: [user_id], references: [id])

  @@index([user_id])
  @@index([entidade, entidade_id])
  @@map("audit_log")
}

// ----------------------- CONFIG DO SISTEMA (Doc 2 §11) -----------------------
// Linha unica (id=1) com parametros editaveis do modelo de custo Private.

model SystemConfig {
  id                   Int     @id @default(1)
  mo_folha_mensal      Decimal @default(75000) @db.Decimal(12, 2)
  mo_dias_uteis        Int     @default(20)
  mo_colaboradores     Int     @default(11)
  imposto_mp_pct       Decimal @default(37.5) @db.Decimal(6, 3)
  imposto_mo_pct       Decimal @default(9.25) @db.Decimal(6, 3)
  ipi_pct              Decimal @default(4.55) @db.Decimal(6, 3)
  desvio_mp_pct        Decimal @default(10) @db.Decimal(6, 3)
  frete_un_brl         Decimal @default(0.10) @db.Decimal(8, 4)
  produtividade_etapas Json? // regras un/min e un/dia por faixa de etapas

  // ALERTAS DE PRECO (Doc 2b §B6)
  alerta_aumento_mp_pct Decimal @default(20.0) @db.Decimal(5, 2)
  alertas_ativos        Boolean @default(true)

  updated_at DateTime @updatedAt

  @@map("system_config")
}

// ----------------------- HISTORICO DE PRECOS DE MP (Doc 2b §B5) -----------------------

model MpHistoricoPreco {
  id                Int      @id @default(autoincrement())
  mp_id             Int
  preco_kg_brl      Decimal  @db.Decimal(10, 2)
  preco_anterior_kg Decimal? @db.Decimal(10, 2)
  variacao_pct      Decimal? @db.Decimal(6, 2)
  fornecedor        String
  data_cotacao      DateTime @db.Date
  origem            String // import_inicial | atualizacao_rapida | cotacao_validada | integracao_omie | integracao_iapp
  fonte_info        String? // ligacao | email | whatsapp | pedido_formal | painel_fornecedor | ultima_compra | outro
  observacoes       String?
  registrado_por    String?  @db.Uuid
  registrado_em     DateTime @default(now())

  mp          MateriaPrima @relation(fields: [mp_id], references: [id], onDelete: Cascade)
  registrador User?        @relation("HistoricoRegistradoPor", fields: [registrado_por], references: [id])

  @@index([mp_id])
  @@index([data_cotacao(sort: Desc)])
  @@map("mp_historico_precos")
}

// ----------------------- ALERTAS (Doc 2b §B6) -----------------------

model Alerta {
  id            Int      @id @default(autoincrement())
  tipo          String // 'aumento_mp', futuro: 'cotacao_vencendo', etc
  titulo        String
  mensagem      String?
  entidade_tipo String? // 'mp', 'formula', etc
  entidade_id   Int?
  severidade    String   @default("info") // info | warn | critical
  lido_por      Json     @default("[]") // array de user_ids que leram
  resolvido     Boolean  @default(false)
  created_at    DateTime @default(now())
  created_for   String[] // roles que devem ver

  @@index([resolvido, created_at(sort: Desc)])
  @@map("alertas")
}

// ----------------------- AMOSTRA EVENTOS (Doc 2c §5.2) -----------------------
// Auditoria de cada transicao de status do pipeline de amostragem.

model AmostraEvento {
  id              Int      @id @default(autoincrement())
  orcamento_id    String   @db.Uuid
  status_anterior String?
  status_novo     String
  observacao      String?
  registrado_por  String?  @db.Uuid
  registrado_em   DateTime @default(now())

  orcamento   Orcamento @relation(fields: [orcamento_id], references: [id], onDelete: Cascade)
  registrador User?     @relation("AmostraEventoPor", fields: [registrado_por], references: [id])

  @@index([orcamento_id])
  @@index([registrado_em(sort: Desc)])
  @@map("amostra_eventos")
}

// ----------------------- INTEGRATION EVENTS (Doc 2c §5.3) -----------------------
// Fila para integracoes futuras (ClickUp/CRM). Na v9 sao CRIADOS mas nenhum
// processador roda — acumulam para quando a integracao for ativada.

model IntegrationEvent {
  id            Int    @id @default(autoincrement())
  tipo          String // amostra_solicitada | amostra_pronta | amostra_enviada | orcamento_aprovado_cliente | orcamento_rejeitado_cliente
  entidade_tipo String // 'orcamento'
  entidade_id   String
  payload       Json

  clickup_status        String    @default("pending") // pending | sent | error | skipped
  clickup_response      Json?
  clickup_processado_em DateTime?

  crm_status        String    @default("pending")
  crm_response      Json?
  crm_processado_em DateTime?

  created_at DateTime @default(now())

  @@index([clickup_status, crm_status])
  @@map("integration_events")
}
