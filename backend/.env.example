# ============================================================
# Private Studio (v9) — Backend env (EXEMPLO)
# Copie para .env e preencha com as credenciais reais da KingHost.
# NUNCA commitar o .env real.
# ============================================================

# App
PORT=3000
NODE_ENV=development

# PostgreSQL 13 — KingHost (pgsql13-farm)
# Formato: postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public
DATABASE_URL="postgresql://USUARIO:SENHA@pgsql13-farm.kinghost.net:5432/BANCO?schema=public"

# Auth (JWT) — gere um segredo forte: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Anthropic API (Fase 1 calculo + Fase 2 formatacao)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"
