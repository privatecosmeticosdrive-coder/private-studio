# ============================================================
# Private Studio (v9) — Backend env (EXEMPLO)
# Copie para .env (local) e preencha. NUNCA commitar o .env real.
# Em producao (Railway), defina estes valores nas Variables do servico.
# ============================================================

# App
# PORT: em dev use 3000. No Railway a porta e INJETADA automaticamente
# (process.env.PORT); o fallback do codigo e 3000.
PORT=3000
NODE_ENV=development

# PostgreSQL
# Local: aponte para seu Postgres. No Railway, adicione o plugin PostgreSQL e
# referencie a variavel dele: DATABASE_URL=${{Postgres.DATABASE_URL}}
# Formato: postgresql://USUARIO:SENHA@HOST:5432/BANCO?schema=public
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/private_studio?schema=public"

# Auth (JWT) — gere um segredo forte: openssl rand -base64 48
JWT_SECRET="troque-por-um-segredo-forte"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Anthropic API (Fase 1 calculo + Fase 2 formatacao) — opcional (mock-safe se vazio)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# CORS — em servico unico (backend serve o frontend) a origem e a mesma, nao
# precisa setar. Se um dia o frontend for hospedado em outro dominio, defina aqui.
# CORS_ORIGIN="https://seu-dominio.com"
