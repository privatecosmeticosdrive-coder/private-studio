{
  "info": {
    "_postman_id": "private-studio-api-0001-0001-000000000001",
    "name": "Private Studio API (v9)",
    "description": "Colecao completa do backend NestJS da Private Cosmeticos.\n\n1) Rode \"Auth > Login\" primeiro (o token e salvo automaticamente em {{token}}).\n2) Ajuste os IDs nas variaveis da colecao (mp_codigo, formula_id, orcamento_id...).\n\nImportavel no Postman e no Insomnia.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
